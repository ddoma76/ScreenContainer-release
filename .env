# Where persistent data (desktop home dir, shared X11 socket) is stored.
DATA_DIR=./data
# Owner of the desktop user's files; set these to the desired host UID/GID.
PUID=1000
PGID=1000
TZ=UTC
# Virtual terminal used by Xorg. Ctrl+Alt+F1 returns to the TrueNAS console, Ctrl+Alt+F7 back here.
VT=7
KMS_DEVICE=/dev/dri/card0
# Keyboard layout, e.g. us, hu, de
XKB_LAYOUT=us
XKB_VARIANT=
XKB_OPTIONS=
# Turn the monitor off after N idle minutes (0 = never).
SCREEN_BLANK_MINUTES=0
# Passwordless sudo inside the container. The container is privileged, so this is effectively root on the NAS.
ENABLE_SUDO=false
# Command started when the desktop comes up, e.g.: firefox-esr http://localhost
AUTOSTART=
